# =============================================================================
# Frontend Development Dockerfile
# =============================================================================
# Starts the Vite development server with hot-reload
# Note: Build context should be the project root, so paths are relative to that
# =============================================================================

FROM oven/bun:1

WORKDIR /app

# Copy package files from frontend directory
COPY frontend/package.json frontend/bun.lock ./

# Install dependencies
RUN bun install

# Copy all frontend source files
COPY frontend/ .

# Expose Vite dev server port
EXPOSE 5173

# Start the development server
# HOST=0.0.0.0 will be set via docker-compose to make Vite accessible from outside
CMD ["bun", "run", "dev"]
